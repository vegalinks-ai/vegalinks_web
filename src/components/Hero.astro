---
import Waveform from './Waveform.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="pill"><span class="dot"></span> Stealth mode · Hiring</span>
      <h1>Interconnect for the<br /><span class="grad">AI era.</span></h1>
      <p class="lead">
        Vega Links is building next-generation high-speed interconnect <strong class="text-bright">beyond 200G</strong>
        for the AI datacenter — spanning the full <strong class="text-bright">0–50m reach</strong>,
        from inside the package to across the rack.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}/careers`}>Join the team</a>
        <a class="btn btn-ghost" href={`${base}/contact`}>Investor inquiries</a>
      </div>
    </div>
    <div class="hero-art">
      <Waveform />
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(48px, 8vw, 96px) 0 clamp(32px, 5vw, 64px); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 2.5rem;
  }
  .grad {
    background: linear-gradient(120deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-copy .lead { margin: 1.4rem 0 2rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  @media (max-width: 920px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-art { order: -1; }
  }
</style>
