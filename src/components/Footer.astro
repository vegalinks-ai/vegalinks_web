---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const links = [
  { href: '/mission', label: 'Mission' },
  { href: '/market', label: 'Market' },
  { href: '/approach', label: 'Approach' },
  { href: '/team', label: 'Team' },
  { href: '/careers', label: 'Careers' },
  { href: '/contact', label: 'Contact' },
];
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand" href={`${base}/`} aria-label="Vega Links home">
        <img class="brand-logo" src={`${base}/logo.png`} alt="Vega Links" />
      </a>
      <p class="footer-tag">Interconnect for the AI era.</p>
      <span class="pill"><span class="dot"></span> Stealth mode</span>
    </div>

    <nav class="footer-links" aria-label="Footer">
      {links.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
    </nav>

    <div class="footer-contact">
      <a href="mailto:info@vegalinks.ai">info@vegalinks.ai</a>
      <a href="mailto:careers@vegalinks.ai">careers@vegalinks.ai</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Vega Links. All rights reserved.</span>
    <span>Building in stealth.</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: rgba(7, 11, 20, 0.6);
    margin-top: 2rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    padding: 56px 24px 32px;
  }
  .brand { display: inline-flex; align-items: center; }
  .brand-logo { height: 104px; width: auto; display: block; }
  .footer-tag { color: var(--muted); margin: 0.9rem 0 1rem; }
  .footer-links { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-links a { color: var(--muted); font-size: 0.92rem; }
  .footer-links a:hover { color: var(--accent); }
  .footer-contact { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-contact a { color: var(--muted); font-size: 0.92rem; }
  .footer-contact a:hover { color: var(--accent); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding: 20px 24px 36px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.82rem;
  }
  @media (max-width: 760px) {
    .footer-inner { grid-template-columns: 1fr; gap: 1.6rem; }
    .footer-bottom { flex-direction: column; gap: 0.4rem; }
  }
</style>
