---
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-header">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header { padding: clamp(56px, 8vw, 96px) 0 clamp(24px, 4vw, 40px); }
  .page-header h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .page-header .lead { margin-top: 1.2rem; }
</style>
