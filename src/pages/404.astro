---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Not found">
  <section class="section">
    <div class="container nf">
      <span class="eyebrow">404</span>
      <h1>Lost in the fabric.</h1>
      <p class="lead">That page doesn't exist — or is still in stealth.</p>
      <a class="btn btn-primary" href={`${base}/`}>Back home</a>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; padding: clamp(40px, 8vw, 100px) 0; }
  .nf .lead { margin: 1rem auto 2rem; }
</style>
