---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RoleCard from '../components/RoleCard.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const roles = [
  { title: 'Chief Product Officer', area: 'Product', blurb: 'Own product strategy and customer engagement across high-speed connectivity. For a leader who has shipped interconnect at scale.' },
  { title: 'DSP Lead Architect', area: 'DSP', blurb: 'Define the DSP architecture for next-generation links. Deep equalization and high-speed transceiver experience required.' },
  { title: 'Broadband System / DSP Engineer', area: 'Systems', blurb: 'Bridge system architecture and DSP modeling for wireline interconnect across a wide range of channels.' },
  { title: 'Analog / Mixed-Signal Lead', area: 'Analog', blurb: 'Architect broadband analog front-ends at the cutting edge of process technology.' },
  { title: 'Digital Lead', area: 'Digital', blurb: 'Lead digital design, integration, and bring-up for production-grade interconnect silicon.' },
];

const perks = [
  { t: 'Founding-team impact', d: 'Senior, high-ownership roles with meaningful equity and a direct line to the technical direction of the company.' },
  { t: 'Hard, valuable problems', d: 'Work at the intersection of analog, mixed-signal, and DSP on a bottleneck the entire AI industry is racing to solve.' },
  { t: 'Proven peers', d: 'Build alongside architects from Inphi, Marvell, Broadcom, AMD, and more — and advisors at the frontier of AI compute.' },
];
---
<Base title="Careers" description="Vega Links is hiring senior analog, mixed-signal, DSP, and digital engineers to build the next generation of high-speed interconnect for AI.">
  <PageHeader
    eyebrow="Careers"
    title="Help build the interconnect the AI era runs on."
    lead="We are a small, senior team in stealth, hiring founding engineers and leaders across the stack. If you have taken high-speed links from one generation to the next, you will feel at home here."
  />

  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {perks.map((p) => (
          <div class="card">
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Open roles</span>
        <h2>We are hiring across every discipline</h2>
        <p class="lead">
          Don't see an exact match? We always want to hear from exceptional analog, mixed-signal,
          DSP, and digital engineers. Reach out anyway.
        </p>
      </div>
      <div class="grid grid-2">
        {roles.map((r) => <RoleCard title={r.title} area={r.area} blurb={r.blurb} />)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="apply-band">
        <div>
          <h2>Ready to talk?</h2>
          <p class="lead">Send a note and a few lines on what you have built. We read every one.</p>
        </div>
        <a class="btn btn-primary" href="mailto:careers@vegalinks.ai?subject=Joining%20Vega%20Links">careers@vegalinks.ai</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .apply-band {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
    background: linear-gradient(135deg, rgba(34,211,238,0.10), rgba(125,211,252,0.04));
    border: 1px solid rgba(34,211,238,0.28); border-radius: var(--radius);
    padding: clamp(1.6rem, 4vw, 2.6rem);
  }
  .apply-band h2 { margin-bottom: 0.4rem; }
  .apply-band p { margin: 0; }
</style>
