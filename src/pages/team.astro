---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const leaders = [
  {
    name: 'Karthik Gopalakrishnan',
    role: 'Founder & CEO',
    photo: 'karthik.png',
    bio: 'Senior Fellow at AMD, where he enabled interconnect solutions for the MI accelerator products. Previously drove 25G–100G PAM4 SerDes development at Inphi, and earlier at Infineon. 26+ years as a broadband analog/mixed-signal expert, system architect, and wireline-interconnect specialist.',
    chips: ['AMD — Senior Fellow', 'Inphi', 'Infineon'],
  },
  {
    name: 'Rajesh Radhamohan',
    role: 'Chief Product Officer',
    photo: 'Rajesh.png',
    bio: '30+ years in broadband analog and product leadership. Led product marketing for the industry’s first 50G/L and 100G/L solutions at Inphi and Maxlinear, driving successful engagements with hyperscale customers. Career spans Cisco, Maxlinear, Inphi, Broadcom, and Lucent.',
    chips: ['Cisco', 'Maxlinear', 'Inphi', 'Broadcom', 'Lucent'],
  },
  {
    name: 'Abhishek Bhat, PhD',
    role: 'Chief Silicon Architect, Datacom',
    photo: 'abhishek.png',
    bio: 'Over a decade of deep-tech expertise in high-speed mixed-signal and RF integrated circuit design. Prior to Vega Links, he was an ASIC Engineering Technical Leader at Cisco, where he pioneered 100G–200G/L optical engines and ultra-low-jitter clocking IPs across advanced nodes. Abhishek holds a PhD from IIT Madras focused on millimeter-wave and low-GHz radios, has authored multiple high-impact IEEE publications (including ISSCC), and holds over 10 US patents. As a founding member of Vega Links, he leads the architectural definition and physical realization of our next-generation interconnect silicon.',
    chips: ['Cisco', 'IIT Madras — PhD', '10+ US patents', 'ISSCC'],
  },
];

const advisors = [
  {
    name: 'Sudeep Bhoja',
    role: 'Co-founder & CTO, d-Matrix',
    photo: 'Sudeep.png',
    bio: 'Data center and AI infrastructure expert. Former CTO of Inphi; previously Broadcom and Bigbear Networks.',
  },
  {
    name: 'Gopal Raghavan',
    role: 'Co-founder, Inphi & Eta Compute',
    photo: 'gopal.png',
    bio: 'Expert in edge AI, memory systems, and broadband analog & mixed-signal. Previously at Microsoft and Cadence.',
  },
];
---
<Base title="Team" description="Vega Links is led by veterans of high-speed SerDes and optical DSP, advised by leaders in AI infrastructure and mixed-signal design.">
  <PageHeader
    eyebrow="Team"
    title="Built by people who have shipped high-speed interconnect."
    lead="A senior team with deep roots in the companies that defined modern SerDes and optical DSP — backed by advisors at the frontier of AI infrastructure."
  />

  <section class="section-tight">
    <div class="container">
      <div class="grid grid-2">
        {leaders.map((p) => (
          <div class="card leader">
            <div class="leader-head">
              <img class="avatar" src={`${base}/${p.photo}`} alt={p.name} width="104" height="104" />
              <div>
                <h3>{p.name}</h3>
                <p class="role">{p.role}</p>
              </div>
            </div>
            <p>{p.bio}</p>
            <div class="chips">
              {p.chips.map((c) => <span class="chip">{c}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Advisors</span>
        <h2>Guided by leaders in AI infrastructure and mixed-signal design</h2>
        <p class="lead">
          Vega Links is advised by industry veterans across AI compute and broadband analog.
        </p>
      </div>
      <div class="grid grid-3">
        {advisors.map((a) => (
          <div class="card advisor">
            <div class="advisor-head">
              <img class="avatar avatar-sm" src={`${base}/${a.photo}`} alt={a.name} width="84" height="84" />
              <div>
                <h3>{a.name}</h3>
                <p class="role">{a.role}</p>
              </div>
            </div>
            <p>{a.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="next">
        <p>We are growing the team across analog, mixed-signal, DSP, and digital.</p>
        <a class="btn btn-primary" href={`${base}/careers`}>See open roles →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .leader { display: flex; flex-direction: column; gap: 0.9rem; }
  .leader-head { display: flex; align-items: center; gap: 1rem; }
  .avatar {
    width: 104px; height: 104px; flex: none; border-radius: 50%; object-fit: cover;
    object-position: center top; filter: grayscale(1); background: var(--accent-soft);
    border: 1px solid rgba(231,152,79,0.3);
  }
  .avatar-sm { width: 84px; height: 84px; }
  .leader-head h3 { margin: 0; }
  .role { color: var(--accent); font-weight: 600; margin: 0.15rem 0 0; }
  .leader p:not(.role) { margin: 0; }
  .advisor { display: flex; flex-direction: column; gap: 0.6rem; }
  .advisor-head { display: flex; align-items: center; gap: 0.85rem; }
  .advisor-head h3 { margin: 0; }
  .advisor p:last-child { margin: 0; }
  .next { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .next p { margin: 0; color: var(--text); font-weight: 600; }
  @media (max-width: 760px) {
    .leader-head { align-items: flex-start; }
  }
</style>
